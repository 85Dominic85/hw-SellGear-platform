# =============================================================
# MainOperation Platform — Variables de entorno
# Copia este archivo como .env.local (Next.js) y .env (scripts)
# NUNCA subas .env / .env.local al repositorio
# =============================================================

# -----------------------------------------------
# SUPABASE
# -----------------------------------------------
# URL del proyecto (ej: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública (anon key) — segura para el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — SOLO en servidor/edge functions, NUNCA en cliente
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Referencia del proyecto (usado por CLI y MCP)
SUPABASE_PROJECT_REF=<project-ref>

# Personal Access Token (para MCP y Supabase CLI)
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# -----------------------------------------------
# GOOGLE SHEETS
# -----------------------------------------------
# ID del spreadsheet MainOperation (de la URL del sheet)
GOOGLE_SHEET_ID=<spreadsheet-id>

# JSON de la Service Account con acceso al sheet
# Opción 1: ruta al fichero JSON
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/service-account.json

# Opción 2: contenido JSON en base64 (para edge functions / CI)
GOOGLE_SERVICE_ACCOUNT_B64=<base64-encoded-json>

# -----------------------------------------------
# TYPEFORM
# -----------------------------------------------
# Secret para validar la firma HMAC del webhook
TYPEFORM_WEBHOOK_SECRET=<typeform-webhook-secret>

# -----------------------------------------------
# SLACK
# -----------------------------------------------
# Webhook URL del canal privado de Hardware
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<T>/<B>/<token>

# -----------------------------------------------
# APP
# -----------------------------------------------
# URL pública de la app (para enlaces en Slack/emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------
# TIPSA (Transporte — Dinapaq SOAP WS)
# -----------------------------------------------
# Entorno activo: "test" (wsval) o "prod" (ws).
# Usar "test" para desarrollo. "prod" solo cuando se acepte el go-live.
TIPSA_ENV=test

# Credenciales por entorno — solicitarlas a TIPSA, NUNCA subir al repo.
# IMPORTANTE: si el password contiene '#' (TIPSA suele usarlo) hay que ENTRECOMILLARLO.
# Sin comillas Next.js trata '#' como comentario y trunca el valor.
# Ejemplo correcto: TIPSA_TEST_PASSWORD="Ts#30#2%4"
TIPSA_TEST_AGENCY_CODE=000000
TIPSA_TEST_CLIENT_CODE=33333
TIPSA_TEST_PASSWORD="<solicitar-a-tipsa>"

TIPSA_PROD_AGENCY_CODE=041033
TIPSA_PROD_CLIENT_CODE=010
TIPSA_PROD_PASSWORD="<solicitar-a-tipsa>"

# Remitente fijo (QR Payments Qamarero)
TIPSA_SENDER_NAME=QR PAYMENTS Qamarero
TIPSA_SENDER_ADDRESS=P.º Alcalde Marqués del Contadero, s/n, Casco Antiguo
TIPSA_SENDER_CITY=Sevilla
TIPSA_SENDER_CP=41001
TIPSA_SENDER_PHONE=602687553

# Catálogo de servicios TIPSA disponible en el selector de la UI.
# Formato JSON: [{"code":"48","label":"24h estándar"}, ...]
# Se puede ajustar sin deploy (solo variable de entorno).
TIPSA_SERVICES_CATALOG=[{"code":"48","label":"24h estándar"},{"code":"10","label":"48h"},{"code":"52","label":"Sábado"},{"code":"40","label":"14h (next day)"},{"code":"01","label":"Económico"}]

# Secret para proteger el cron endpoint de polling (Fase 2)
# Generar con: openssl rand -hex 32
TIPSA_CRON_SECRET=<openssl-rand-hex-32>
