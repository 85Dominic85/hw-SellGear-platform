# =============================================================
# MainOperation Platform — Variables de entorno
# Copia este archivo como .env.local (Next.js) y .env (scripts)
# NUNCA subas .env / .env.local al repositorio
# =============================================================

# -----------------------------------------------
# SUPABASE
# -----------------------------------------------
# URL del proyecto (ej: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública (anon key) — segura para el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — SOLO en servidor/edge functions, NUNCA en cliente
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Referencia del proyecto (usado por CLI y MCP)
SUPABASE_PROJECT_REF=<project-ref>

# Personal Access Token (para MCP y Supabase CLI)
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# -----------------------------------------------
# GOOGLE SHEETS
# -----------------------------------------------
# ID del spreadsheet MainOperation (de la URL del sheet)
GOOGLE_SHEET_ID=<spreadsheet-id>

# JSON de la Service Account con acceso al sheet
# Opción 1: ruta al fichero JSON
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/service-account.json

# Opción 2: contenido JSON en base64 (para edge functions / CI)
GOOGLE_SERVICE_ACCOUNT_B64=<base64-encoded-json>

# -----------------------------------------------
# TYPEFORM
# -----------------------------------------------
# Secret para validar la firma HMAC del webhook
TYPEFORM_WEBHOOK_SECRET=<typeform-webhook-secret>

# -----------------------------------------------
# SLACK
# -----------------------------------------------
# Webhook URL del canal privado de Hardware
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<T>/<B>/<token>

# -----------------------------------------------
# APP
# -----------------------------------------------
# URL pública de la app (para enlaces en Slack/emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
