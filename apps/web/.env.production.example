NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NiIt2nC-Axl0fjjpDMurhw_N4bRyVwx

# URL pública de la app en Vercel (Vercel lo inyecta automáticamente,
# pero ponlo explícito para los enlaces de Slack/email)
