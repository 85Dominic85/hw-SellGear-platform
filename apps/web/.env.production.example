# =============================================================
# Variables de entorno para PRODUCCIÓN (Vercel)
# En Vercel: Project Settings → Environment Variables
# =============================================================

# Supabase — mismo proyecto que local
NEXT_PUBLIC_SUPABASE_URL=https://gbuifpsgcvxmuwzoyush.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NiIt2nC-Axl0fjjpDMurhw_N4bRyVwx

# URL pública de la app en Vercel (Vercel lo inyecta automáticamente,
# pero ponlo explícito para los enlaces de Slack/email)
NEXT_PUBLIC_APP_URL=https://hw-sellgear-platform.vercel.app

# =============================================================
# Integración con HW Main Portal (API pública de métricas)
# =============================================================
# API key dedicada que el portal HW manda en el header X-API-Key.
# Genera con: openssl rand -hex 32
MAIN_PORTAL_API_KEY=<random-hex-32>
# CSV de orígenes permitidos para CORS desde browser. Para llamadas
# server-to-server (sin Origin) no se aplica CORS y se puede dejar vacío.
MAIN_PORTAL_ORIGIN=https://portal.hw.qamarero.com

# =============================================================
# Qarvis (cerebro del ecosistema) — clave compartida de solo lectura
# =============================================================
# validateApiKey acepta esta clave ADEMÁS de la específica de cada endpoint,
# de forma retro-compatible (no toca MAIN_PORTAL_API_KEY ni HWTOOLBOX_API_KEY).
# Con ella Qarvis lee /api/external/metrics y /api/external/hwtoolbox/*.
# En Qarvis, esta misma clave se configura como MAINOPS_API_KEY.
# Genera con: openssl rand -hex 32
QARVIS_API_KEY=<random-hex-32>
