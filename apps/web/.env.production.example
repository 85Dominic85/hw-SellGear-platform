# =============================================================
# Integración con HW Main Portal (API pública de métricas)
# =============================================================
# API key dedicada que el portal HW manda en el header X-API-Key.
# Genera con: openssl rand -hex 32
MAIN_PORTAL_API_KEY=<random-hex-32>
# CSV de orígenes permitidos para CORS desde browser. Para llamadas
# server-to-server (sin Origin) no se aplica CORS y se puede dejar vacío.
MAIN_PORTAL_ORIGIN=https://portal.hw.qamarero.com
